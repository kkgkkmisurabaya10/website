<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Pendaftaran Tryout TKA | KKGMI Surabaya 10</title>

  <!-- Favicon -->
  <link
    rel="icon"
    type="image/png"
    href="https://lh3.googleusercontent.com/d/1ubuQI39XRtOp5TeqR__EyPxtRAq7Ninu"
  />

  <meta
    name="description"
    content="Pendaftaran Tryout TKA yang diselenggarakan oleh KKGMI Surabaya 10."
  />

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      width: 100%;
      min-height: 100%;
      font-family: Arial, Helvetica, sans-serif;
      background: #f5f7fb;
      color: #1f2937;
    }

    body {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    .header {
      background: linear-gradient(135deg, #5b21b6, #7c3aed);
      color: #ffffff;
      padding: 18px 20px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
      position: relative;
      z-index: 10;
    }

    .header-container {
      max-width: 1400px;
      margin: auto;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .logo {
      width: 65px;
      height: 65px;
      object-fit: contain;
      background: #ffffff;
      border-radius: 14px;
      padding: 5px;
      flex-shrink: 0;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
    }

    .header-text {
      flex: 1;
    }

    .header-text h1 {
      font-size: 24px;
      margin-bottom: 5px;
      font-weight: 700;
    }

    .header-text p {
      font-size: 14px;
      line-height: 1.5;
      opacity: 0.95;
    }

    .info-bar {
      background: #ffffff;
      border-bottom: 1px solid #e5e7eb;
      padding: 10px 20px;
      text-align: center;
      font-size: 14px;
      color: #4b5563;
      box-shadow: 0 2px 7px rgba(0, 0, 0, 0.04);
    }

    .info-bar strong {
      color: #6d28d9;
    }

    .embed-wrapper {
      flex: 1;
      width: 100%;
      position: relative;
      background: #ffffff;
    }

    iframe {
      width: 100%;
      height: calc(100vh - 158px);
      min-height: 650px;
      border: none;
      display: block;
      background: #ffffff;
    }

    .footer {
      background: #111827;
      color: #d1d5db;
      text-align: center;
      padding: 10px 15px;
      font-size: 12px;
    }

    .footer strong {
      color: #ffffff;
    }

    @media (max-width: 768px) {
      .header {
        padding: 13px 12px;
      }

      .header-container {
        gap: 11px;
      }

      .logo {
        width: 52px;
        height: 52px;
        border-radius: 10px;
      }

      .header-text h1 {
        font-size: 17px;
        margin-bottom: 3px;
      }

      .header-text p {
        font-size: 12px;
      }

      .info-bar {
        font-size: 12px;
        padding: 8px 12px;
      }

      iframe {
        height: calc(100vh - 137px);
        min-height: 600px;
      }

      .footer {
        font-size: 10px;
        padding: 8px;
      }
    }

    @media (max-width: 420px) {
      .header-text h1 {
        font-size: 15px;
      }

      .header-text p {
        font-size: 11px;
      }

      .logo {
        width: 47px;
        height: 47px;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <header class="header">
    <div class="header-container">

      <img
        src="https://lh3.googleusercontent.com/d/1ubuQI39XRtOp5TeqR__EyPxtRAq7Ninu"
        alt="Logo KKGMI Surabaya 10"
        class="logo"
      />

      <div class="header-text">
        <h1>Pendaftaran Tryout TKA</h1>
        <p>
          Diselenggarakan oleh <strong>KKGMI Surabaya 10</strong>
        </p>
      </div>

    </div>
  </header>

  <!-- INFORMASI -->
  <div class="info-bar">
    Silakan lengkapi formulir <strong>Pendaftaran Tryout TKA KKGMI Surabaya 10</strong>
    dengan data yang benar dan lengkap.
  </div>

  <!-- EMBED WEBSITE -->
  <main class="embed-wrapper">

    <iframe
      src="https://daftar-wanto1.vercel.app"
      title="Pendaftaran Tryout TKA KKGMI Surabaya 10"
      allow="camera; microphone; clipboard-read; clipboard-write"
      loading="eager"
    ></iframe>

  </main>

  <!-- FOOTER -->
  <footer class="footer">
    © 2026 <strong>KKGMI Surabaya 10</strong> • Tryout TKA
  </footer>

</body>
</html>
